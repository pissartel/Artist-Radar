# Copy to .env at the repo root (never commit the real .env — it's already
# gitignored). This file documents every environment variable the backend
# pipeline and frontend actually read; see src/ and frontend/src/ for usage.

# ---- Required ----
# Without this, POST /api/artist-radar fails fast with a structured
# MISSING_REQUIRED_CONFIG error instead of running the pipeline.
OPENAI_API_KEY=

# ---- Core AI pipeline tuning (optional, sensible defaults if unset) ----
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=
RAG_RETRIEVAL_LIMIT=
ENABLE_AI_JUDGE=

# ---- Similar-artist consolidation (optional) ----
CONSOLIDATE_SIMILAR_ARTISTS=
CONSOLIDATE_SIMILAR_ARTISTS_LIMIT=
VERIFY_SIMILAR_ARTISTS_LIMIT=

# ---- Provider API keys (all optional — each provider degrades gracefully
# and is simply skipped when its key/toggle is missing; the analysis still
# runs on whichever sources are available) ----
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=
LASTFM_API_KEY=
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
JINA_API_KEY=
OPENAGENDA_API_KEY=

# ---- Provider/feature enable flags (optional, "true" to enable — most
# default to disabled) ----
ENABLE_SPOTIFY_RELATED_ARTISTS=
ENABLE_SPOTIFY_TOP_TRACKS=
ENABLE_TAVILY_SEARCH=
ENABLE_TAVILY_BOOKING=
ENABLE_EXA_SEARCH=
ENABLE_EXA_BOOKING=
ENABLE_JINA_READER=
ENABLE_FIRECRAWL_BOOKING=
ENABLE_FIRECRAWL_CONSOLIDATION=
ENABLE_OPENAGENDA=
ENABLE_OPENAGENDA_BOOKING=
ENABLE_SCENE_AGENDAS=

# ---- OpenAgenda source configuration (optional) ----
OPENAGENDA_BASE_URL=
OPENAGENDA_AGENDA_UID=
OPENAGENDA_AGENDA_UIDS=
OPENAGENDA_DISCOVER_ADDITIONAL_AGENDAS=

# ---- Organization data-source import (optional, npm run import:organizations) ----
# Comma-separated label/organization names to look up via each connector.
MUSICBRAINZ_LABEL_QUERIES=
WIKIDATA_ORGANIZATION_QUERIES=

# ---- Targeted web discovery of bookers/managers/associations (optional,
# npm run import:organizations; requires a web search provider configured
# above, e.g. TAVILY_API_KEY + ENABLE_TAVILY_SEARCH) ----
# Comma-separated genres, target cities, similar artist names, and
# already-discovered venue/festival names used to build discovery queries.
DISCOVERY_GENRES=
DISCOVERY_ARTIST_CITY=
DISCOVERY_ARTIST_COUNTRY=
DISCOVERY_TARGET_CITIES=
DISCOVERY_SIMILAR_ARTISTS=
DISCOVERY_KNOWN_ORGANIZATION_NAMES=

# ---- Misc provider tuning (optional) ----
APP_USER_AGENT=
BOOKING_RECENT_EVENT_MONTHS=
FIRECRAWL_TIMEOUT_MS=
WEB_PROVIDER_TIMEOUT_MS=
WEB_PROVIDER_DAILY_BUDGET_GUARD=

# ---- Testing / debug (optional, local development only — never set these
# in Production) ----
# MOCK_AI=true bypasses real provider calls for local/CI testing.
MOCK_AI=
EXPORT_DEBUG_EVIDENCE=
# Per-scope verbose logging, one flag per pipeline stage — all default off:
# DEBUG_SPOTIFY, DEBUG_LASTFM, DEBUG_MUSICBRAINZ, DEBUG_WIKIDATA, DEBUG_FIRECRAWL,
# DEBUG_WEB_SEARCH, DEBUG_ARTIST_VERIFICATION, DEBUG_ARTIST_CONSOLIDATION,
# DEBUG_SIMILAR_ARTISTS, DEBUG_SEEDS, DEBUG_PROFILE, DEBUG_YOUTUBE,
# DEBUG_EVENTS, DEBUG_PIPELINE, DEBUG_BOOKING, DEBUG_GENRE, DEBUG_SOURCES
# (see src/utils/logger.ts)

# ---- Frontend (optional, must NOT use NEXT_PUBLIC_ for real secrets —
# this one is a UI visibility flag only) ----
# Set to "true" to show developer-only UI (raw JSON views, detailed
# provider warnings) locally or in a Preview deployment. Must stay unset
# (or "false") in Production. See frontend/src/lib/productFeatures.ts.
NEXT_PUBLIC_ENABLE_DEBUG_UI=
