# Copy to .env at the repo root (never commit the real .env — it's already
# gitignored). This file documents every environment variable the backend
# pipeline and frontend actually read; see src/ and frontend/src/ for usage.

# ---- Required ----
# Without this, POST /api/artist-radar fails fast with a structured
# MISSING_REQUIRED_CONFIG error instead of running the pipeline.
OPENAI_API_KEY=

# ---- Core AI pipeline tuning (optional, sensible defaults if unset) ----
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=
RAG_RETRIEVAL_LIMIT=
ENABLE_AI_JUDGE=

# ---- Similar-artist consolidation (optional) ----
CONSOLIDATE_SIMILAR_ARTISTS=
CONSOLIDATE_SIMILAR_ARTISTS_LIMIT=
VERIFY_SIMILAR_ARTISTS_LIMIT=

# ---- Provider API keys (all optional — each provider degrades gracefully
# and is simply skipped when its key/toggle is missing; the analysis still
# runs on whichever sources are available) ----
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=
LASTFM_API_KEY=
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
JINA_API_KEY=
OPENAGENDA_API_KEY=
BANDSINTOWN_APP_ID=
SONGKICK_API_KEY=
SETLISTFM_API_KEY=
TICKETMASTER_API_KEY=

# ---- Provider/feature enable flags (optional, "true" to enable — most
# default to disabled) ----
ENABLE_SPOTIFY_RELATED_ARTISTS=
ENABLE_SPOTIFY_TOP_TRACKS=
ENABLE_TAVILY_SEARCH=
ENABLE_TAVILY_BOOKING=
ENABLE_EXA_SEARCH=
ENABLE_EXA_BOOKING=
ENABLE_JINA_READER=
ENABLE_FIRECRAWL_BOOKING=
ENABLE_FIRECRAWL_CONSOLIDATION=
ENABLE_OPENAGENDA=
ENABLE_OPENAGENDA_BOOKING=
ENABLE_SCENE_AGENDAS=
# Complementary similar-artist concert-history venue discovery via
# MusicBrainz events (issue #182). Opt-in and off by default: resolving each
# similar artist's MusicBrainz ID and browsing its events are serialized
# through MusicBrainz's shared 1-request/second rate limit, so this adds
# real latency. OpenAgenda (ENABLE_OPENAGENDA above) remains the default,
# primary structured source for the same feature and needs no extra flag.
ENABLE_MUSICBRAINZ_EVENT_HISTORY=
ENABLE_TICKETMASTER_CONCERTS=
ENABLE_OPENAI_CONCERT_DISCOVERY=

# ---- OpenAgenda source configuration (optional) ----
OPENAGENDA_BASE_URL=
OPENAGENDA_AGENDA_UID=
OPENAGENDA_AGENDA_UIDS=
OPENAGENDA_DISCOVER_ADDITIONAL_AGENDAS=

# ---- Ticketmaster Discovery API configuration (optional, sensible
# defaults if unset: 100 / 50 / 5 / 12 / 18) ----
TICKETMASTER_COUNTRY_CODE=
TICKETMASTER_SEARCH_RADIUS_KM=
TICKETMASTER_EVENT_LIMIT=
TICKETMASTER_SIMILAR_ARTIST_LIMIT=
TICKETMASTER_LOOKAHEAD_MONTHS=
TICKETMASTER_PAST_LOOKBACK_MONTHS=

# ---- OpenAI Web Search concert discovery for similar artists (optional,
# complements Ticketmaster/OpenAgenda for emerging artists, DIY venues and
# past shows; reuses OPENAI_API_KEY above; sensible defaults if unset:
# 5 / 18 / 12 / 10 / 1) ----
OPENAI_CONCERT_MODEL=
OPENAI_CONCERT_SIMILAR_ARTIST_LIMIT=
OPENAI_CONCERT_PAST_MONTHS=
OPENAI_CONCERT_UPCOMING_MONTHS=
OPENAI_CONCERT_MAX_EVENTS_PER_ARTIST=
OPENAI_CONCERT_CONCURRENCY=

# ---- Organization data-source import (optional, npm run import:organizations) ----
# Comma-separated label/organization names to look up via each connector.
MUSICBRAINZ_LABEL_QUERIES=
WIKIDATA_ORGANIZATION_QUERIES=

# ---- Structured label discovery: MusicBrainz release credits + optional
# Discogs consolidation + official-site/Bandcamp enrichment (issue #195,
# additive on top of the web-search label discovery above). MusicBrainz
# defaults ON once MUSICBRAINZ_USER_AGENT or APP_USER_AGENT is set (an
# unconfigured environment stays fully offline, like the web-search
# providers without an API key); ENABLE_MUSICBRAINZ_LABEL_DISCOVERY forces it
# on/off regardless. Bandcamp enrichment defaults ON. Discogs stays off until
# DISCOGS_TOKEN is set. ----
MUSICBRAINZ_USER_AGENT=
DISCOGS_TOKEN=
ENABLE_MUSICBRAINZ_LABEL_DISCOVERY=
ENABLE_DISCOGS_LABEL_ENRICHMENT=
ENABLE_BANDCAMP_LABEL_ENRICHMENT=

# ---- Chartmetric artist-audience enrichment (issue #142, optional,
# usage-based API credits — stays fully off without a refresh token).
# Retrieves only Spotify monthly listeners/followers for the main analyzed
# artist via an exact/high-confidence match; never the sole source of
# artist identity. CHARTMETRIC_ARTIST_ENRICHMENT_ENABLED is the local
# server-side kill switch (default on once a token is set, "false" to
# force off); CHARTMETRIC_FLAG_SERVICE_URL optionally points at a remotely
# hosted flag service so the feature can be killed without a redeploy —
# if configured but unreachable, Chartmetric fails closed (disabled)
# rather than guessing. In preview/development the request must also send
# features.chartmetricArtistEnrichment=true (see the onboarding toggle,
# gated by NEXT_PUBLIC_ENABLE_CHARTMETRIC_TOGGLE below); in production only
# the server-side flag matters. ----
CHARTMETRIC_REFRESH_TOKEN=
CHARTMETRIC_ARTIST_ENRICHMENT_ENABLED=
CHARTMETRIC_FLAG_SERVICE_URL=
CHARTMETRIC_FLAG_SERVICE_TIMEOUT_MS=
CHARTMETRIC_BASE_URL=
CHARTMETRIC_REQUEST_TIMEOUT_MS=
# Usage/cost controls: sensible defaults if unset (1 call per analysis, no
# daily/monthly credit cap).
CHARTMETRIC_MAX_CALLS_PER_ANALYSIS=
CHARTMETRIC_DAILY_CREDIT_LIMIT=
CHARTMETRIC_MONTHLY_CREDIT_LIMIT=

# ---- Chartmetric similar-artist candidate enrichment (issue #201, shares
# the CHARTMETRIC_REFRESH_TOKEN/CHARTMETRIC_ARTIST_ENRICHMENT_ENABLED kill
# switch above). Enriches only the top-N already-discovered similar-artist
# candidates (ranked by existing relevance) with Chartmetric audience/score/
# social/playlist/growth data, used to compute a commercial-scale tier
# (same_level/slightly_larger/aspirational/major_reference/
# local_compatible_artist) alongside the existing musical-relevance ranking.
# Independent per-analysis call budget from CHARTMETRIC_MAX_CALLS_PER_ANALYSIS
# above so this feature's cost can be tuned without touching the main-artist
# call cap; still subject to the same daily/monthly credit limits. ----
CHARTMETRIC_SIMILAR_ARTIST_ENRICHMENT_LIMIT=
CHARTMETRIC_SIMILAR_ARTIST_MAX_CALLS_PER_ANALYSIS=

# ---- Targeted web discovery of bookers/managers/associations (optional,
# npm run import:organizations; requires a web search provider configured
# above, e.g. TAVILY_API_KEY + ENABLE_TAVILY_SEARCH) ----
# Comma-separated genres, target cities, similar artist names, and
# already-discovered venue/festival names used to build discovery queries.
DISCOVERY_GENRES=
DISCOVERY_ARTIST_CITY=
DISCOVERY_ARTIST_COUNTRY=
DISCOVERY_TARGET_CITIES=
DISCOVERY_SIMILAR_ARTISTS=
DISCOVERY_KNOWN_ORGANIZATION_NAMES=

# ---- Misc provider tuning (optional) ----
APP_USER_AGENT=
BOOKING_RECENT_EVENT_MONTHS=
FIRECRAWL_TIMEOUT_MS=
WEB_PROVIDER_TIMEOUT_MS=
WEB_PROVIDER_DAILY_BUDGET_GUARD=

# ---- Similar-artist concert-history venue discovery limits (optional,
# issue #182 — sensible defaults if unset: 10 / 20 / 24) ----
BOOKING_MAX_SIMILAR_ARTISTS_FOR_VENUE_HISTORY=
BOOKING_MAX_HISTORICAL_EVENTS_PER_ARTIST=
BOOKING_HISTORICAL_EVENT_LOOKBACK_MONTHS=

# ---- Similar-artist concert history enrichment (Bandsintown/Songkick/
# setlist.fm; optional, sensible defaults if unset: 10 / 18 / 10 / 10) ----
SIMILAR_ARTISTS_CONCERT_LIMIT=
RECENT_PAST_MONTHS=
PAST_EVENTS_PER_ARTIST=
UPCOMING_EVENTS_PER_ARTIST=
CONCERT_PROVIDER_TIMEOUT_MS=

# ---- Testing / debug (optional, local development only — never set these
# in Production) ----
# MOCK_AI=true bypasses real provider calls for local/CI testing.
MOCK_AI=
EXPORT_DEBUG_EVIDENCE=
# Per-scope verbose logging, one flag per pipeline stage — all default off:
# DEBUG_SPOTIFY, DEBUG_LASTFM, DEBUG_MUSICBRAINZ, DEBUG_WIKIDATA, DEBUG_FIRECRAWL,
# DEBUG_WEB_SEARCH, DEBUG_ARTIST_VERIFICATION, DEBUG_ARTIST_CONSOLIDATION,
# DEBUG_SIMILAR_ARTISTS, DEBUG_SEEDS, DEBUG_PROFILE, DEBUG_YOUTUBE,
# DEBUG_EVENTS, DEBUG_PIPELINE, DEBUG_BOOKING, DEBUG_GENRE, DEBUG_SOURCES,
# DEBUG_LABELS, DEBUG_CHARTMETRIC
# (see src/utils/logger.ts)
# DEBUG_ARTIST_CONCERTS=true shows detailed per-artist/per-provider
# concert-history logs; a compact final summary always prints regardless.
DEBUG_ARTIST_CONCERTS=
# DEBUG_TICKETMASTER_CONCERTS=true shows detailed per-artist/per-provider
# Ticketmaster logs; a compact final summary always prints regardless.
DEBUG_TICKETMASTER_CONCERTS=
# DEBUG_OPENAI_CONCERTS=true shows detailed per-artist OpenAI Web Search
# concert-discovery logs; a compact final summary always prints regardless.
DEBUG_OPENAI_CONCERTS=

# ---- Frontend (optional, must NOT use NEXT_PUBLIC_ for real secrets —
# this one is a UI visibility flag only) ----
# Set to "true" to show developer-only UI (raw JSON views, detailed
# provider warnings) locally or in a Preview deployment. Must stay unset
# (or "false") in Production. See frontend/src/lib/productFeatures.ts.
NEXT_PUBLIC_ENABLE_DEBUG_UI=
# Strictly development/Preview-only, developer-facing UI flag — it has NO
# effect in Production. Set to "true" to show the "Use Chartmetric
# enrichment" onboarding checkbox (issue #142) locally or in a Preview
# deployment; even if this is accidentally left "true" in a Production
# environment's config, the checkbox still never renders there (the
# server computes and enforces the current environment itself — see
# frontend/src/lib/server/chartmetricToggle.ts — rather than trusting this
# var alone). In Production, standard users never see or choose a data
# provider: Chartmetric enrichment runs automatically and silently
# whenever the server-side CHARTMETRIC_* flags above are enabled, with no
# UI and no request-level opt-in required.
NEXT_PUBLIC_ENABLE_CHARTMETRIC_TOGGLE=
